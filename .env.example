# Copie para .env. Os valores abaixo servem apenas para desenvolvimento local.

# Banco de dados
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_dev
POSTGRES_DB=agenda
DATABASE_URL=postgresql+asyncpg://agenda:agenda_dev@db:5432/agenda

# Segurança: ao menos 32 caracteres cada. Em produção, gere com: openssl rand -hex 32
JWT_SECRET=somente-desenvolvimento-troque-em-producao-1
RATE_LIMIT_KEY_SECRET=somente-desenvolvimento-troque-em-producao-2

# E-mail: smtp, fake ou resend. Em desenvolvimento, smtp entrega ao Mailpit, cuja
# interface fica em http://localhost:8025. Com resend, RESEND_API_KEY é obrigatória.
EMAIL_BACKEND=smtp
EMAIL_FROM=Agenda Inteligente <nao-responda@localhost>
SMTP_HOST=mailpit
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_DAILY_CAP=100
EMAIL_RECIPIENT_DAILY_CAP=3

# Aplicação
REGISTRATION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_BASE_URL=http://localhost:5173
# Cabeçalho com o IP do cliente, definido pelo proxy da hospedagem. Vazio sem proxy.
TRUSTED_CLIENT_IP_HEADER=
