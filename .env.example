# Copie para .env. Os valores abaixo servem apenas para desenvolvimento local.

# Banco de dados
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_dev
POSTGRES_DB=agenda
DATABASE_URL=postgresql+asyncpg://agenda:agenda_dev@db:5432/agenda

# Segurança: ao menos 32 caracteres cada. Em produção, gere com: openssl rand -hex 32
JWT_SECRET=somente-desenvolvimento-troque-em-producao-1
RATE_LIMIT_KEY_SECRET=somente-desenvolvimento-troque-em-producao-2

# E-mail: smtp, fake ou resend. Em desenvolvimento, smtp entrega ao Mailpit, cuja
# interface fica em http://localhost:8025. Com resend, RESEND_API_KEY é obrigatória.
EMAIL_BACKEND=smtp
EMAIL_FROM=Agenda Inteligente <nao-responda@localhost>
SMTP_HOST=mailpit
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_DAILY_CAP=100
EMAIL_RECIPIENT_DAILY_CAP=3

# Demo: senha das contas dono@demo.example.com e profissional@demo.example.com,
# de 12 a 128 caracteres. Só a restauração da demo a exige; a API sobe sem ela.
# Restaure com: docker compose run --rm api python -m app.jobs.restore_demo
DEMO_PASSWORD=demo-somente-desenvolvimento

# Tarefas dentro do processo da API (D105, D106), para hospedagens sem worker
# próprio, como o plano grátis do Render. Independentes, e só em produção:
# localmente, o serviço worker do docker-compose envia os e-mails e a
# restauração roda sob demanda, com o comando acima.
# - EMAIL_WORKER_IN_PROCESS: a API envia a fila de e-mails a cada 5 s. Não
#   ligue junto com o serviço worker sem necessidade (funcionaria, pela reserva
#   da D38, mas seriam dois workers).
# - DEMO_RESTORE_IN_PROCESS: a API restaura a demo uma vez por dia, depois das
#   03:00 de America/Sao_Paulo. Só na instalação da demo pública, nunca numa
#   instalação real; ligada, a API não sobe sem um DEMO_PASSWORD válido.
# A limpeza diária dos contadores e dos e-mails antigos (D115) roda no worker,
# onde quer que ele esteja, e não depende de nenhuma das duas.
EMAIL_WORKER_IN_PROCESS=false
DEMO_RESTORE_IN_PROCESS=false

# Aplicação
REGISTRATION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
FRONTEND_BASE_URL=http://localhost:5174
# Cabeçalho com o IP do cliente, definido pelo proxy da hospedagem. Vazio sem proxy.
TRUSTED_CLIENT_IP_HEADER=

# Frontend (D52). Em desenvolvimento, o Vite repassa /api para a API, então o
# frontend e a API ficam na mesma origem. Fora do Docker, use http://localhost:8002.
VITE_API_PROXY_TARGET=http://api:8000
# Origem da API no build de produção, como https://api.exemplo.com. Vazio usa a
# mesma origem do frontend.
VITE_API_BASE_URL=
# Senha do atalho "Conhecer pela demonstração" em /entrar (D75). Toda variável
# VITE_ é pública: vai no JavaScript que o navegador baixa. Use só a senha da
# demo (pública e travada pela RN28), nunca a de uma conta real. Vazia, o atalho
# some. No docker-compose, o padrão é o DEMO_PASSWORD acima.
VITE_DEMO_PASSWORD=
