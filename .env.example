# Copie para .env. Os valores abaixo servem apenas para desenvolvimento local.

# Banco de dados
POSTGRES_USER=agenda
POSTGRES_PASSWORD=agenda_dev
POSTGRES_DB=agenda
DATABASE_URL=postgresql+asyncpg://agenda:agenda_dev@db:5432/agenda

# Segurança
JWT_SECRET=troque-em-producao
RATE_LIMIT_KEY_SECRET=troque-em-producao

# E-mail: console, fake ou resend
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_DAILY_CAP=100
EMAIL_RECIPIENT_DAILY_CAP=3

# Aplicação
REGISTRATION_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:5173
